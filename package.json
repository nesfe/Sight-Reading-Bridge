{
  "name": "sight-reading-bridge",
  "private": true,
  "version": "0.3.2",
  "description": "Progressive Electron piano sight-reading trainer with Web MIDI support.",
  "author": {
    "name": "nesfe",
    "email": "96023593+nesfe@users.noreply.github.com"
  },
  "homepage": "https://github.com/nesfe/Sight-Reading-Bridge",
  "desktopName": "Sight Reading Bridge",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 0.0.0.0",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --development",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node tests/electron-smoke.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run lint && npm run test && npm run build && node scripts/package-desktop.cjs",
    "dist:linux": "npm run dist -- --linux AppImage deb rpm"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.21.0",
    "opensheetmusicdisplay": "^2.1.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vexflow": "^4.2.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.sightreadingbridge.desktop",
    "productName": "Sight Reading Bridge",
    "artifactName": "Sight-Reading-Bridge-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "apps/desktop/*.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "deb": {
      "compression": "gz"
    },
    "rpm": {
      "compression": "gzip"
    },
    "linux": {
      "category": "Education",
      "maintainer": "nesfe <96023593+nesfe@users.noreply.github.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
